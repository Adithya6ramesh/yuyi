# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- Node / React (frontend, later phases) ----------
node_modules/
dist/
build/
.next/
.vercel/
npm-debug.log*
yarn-error.log*

# ---------- Secrets & editor junk ----------
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Docs & working notes (kept locally, not committed) ----------
docs/
CLAUDE.md

# ---------- Data ----------
# Raw downloads (backend/data/raw/) can be re-created with `python -m app.data.fetch`,
# so we don't commit them. These ARE committed:
#   samples/   - small Phase 0 samples, to look at without running anything
#   processed/ - the clean data the app reads (small: well under 1 MB)
backend/data/*
!backend/data/samples/
!backend/data/processed/
